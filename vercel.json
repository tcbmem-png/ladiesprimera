{
  "rewrites": [
    { "source": "/gracias", "destination": "/gracias/index.html" },
    { "source": "/welcome-anel", "destination": "/welcome-anel/index.html" },
    { "source": "/welcome-ladies", "destination": "/welcome-ladies/index.html" },
    { "source": "/welcome-customers", "destination": "/welcome-customers/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
